# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8

# ----------------------------------------------------
# 基础属性保留
# ----------------------------------------------------
-keepattributes EnclosingMethod,InnerClasses,Signature,SourceFile,LineNumberTable,*Annotation*
-keepattributes RuntimeVisibleAnnotations,RuntimeVisibleParameterAnnotations,RuntimeVisibleTypeAnnotations

# ----------------------------------------------------
# Kotlinx Serialization & Data Models
# ----------------------------------------------------
# 只保留带有 @Serializable 注解的类及其成员
-keep @kotlinx.serialization.Serializable class * { *; }
-keepclassmembers class * {
    *** Companion;
    *** serializer(...);
}
# 精确保留业务数据类
-keep class com.ai.wangcai.data.** {
    <fields>;
    <init>(...);
}

# ----------------------------------------------------
# Ktor & Vico (移除过宽规则)
# ----------------------------------------------------
# 现代 AAR 库通常自带混淆规则，不再手动全量保留。
# 如果运行时发现 Ktor 或 Vico 崩溃，再根据报错精准添加。
-dontwarn io.ktor.**
-keep class kotlinx.coroutines.debug.** { *; }

# ----------------------------------------------------
# Apache POI (Excel) & XMLBeans 增强保留规则
# ----------------------------------------------------
# 极其重要的保留规则：不要全量保留 org.apache.poi.** 以免触碰缺失的 AWT 签名
-keep class org.apache.poi.xssf.** { *; }
-keep class org.apache.poi.ss.** { *; }
-keep class org.apache.poi.util.** { *; }
-keep class org.apache.poi.POIXML* { *; }
-keep class org.apache.poi.openxml4j.** { *; }

-keep class org.apache.xmlbeans.** { *; }
-keep class org.openxmlformats.schemas.** { *; }
-keep class schemaorg_apache_xmlbeans.** { *; }
-keep class com.microsoft.schemas.** { *; }
-keep class org.apache.poi.schemas.** { *; }

# 特别保留 TypeSystemHolder 的静态字段，这是 XMLBeans 加载的核心入口
-keepclassmembers class org.apache.xmlbeans.metadata.** {
    public static *** typeSystem;
}
-keepclassmembers class org.apache.poi.schemas.** {
    public static *** typeSystem;
}

# 保留实现类和接口
-keep class org.apache.xmlbeans.impl.** { *; }
-keep class org.apache.xmlbeans.SchemaTypeSystem { *; }
-keep class * implements org.apache.xmlbeans.SchemaTypeSystem { *; }

# 核心：防止 R8 移除或重命名资源文件 (关键是 .xsb 文件)
-keep class org.apache.poi.xssf.usermodel.** { *; }

# 允许访问内部类和泛型签名
-keepattributes InnerClasses, Signature, EnclosingMethod

# 屏蔽警告 (POI 引用了很多 Java SE 桌面端、OSGi 和各种日志库)
-dontwarn org.apache.poi.**
-dontwarn org.apache.xmlbeans.**
-dontwarn org.openxmlformats.schemas.**
-dontwarn com.microsoft.schemas.**
-dontwarn org.apache.commons.compress.**
-dontwarn org.apache.commons.collections4.**
-dontwarn org.apache.commons.math3.**
-dontwarn org.apache.zstd.**
-dontwarn com.github.luben.zstd.**
-dontwarn java.awt.**
-dontwarn javax.xml.stream.**
-dontwarn javax.imageio.**
-dontwarn javax.swing.**
-dontwarn aQute.bnd.annotation.**
-dontwarn edu.umd.cs.findbugs.annotations.**
-dontwarn org.osgi.framework.**
-dontwarn org.osgi.resource.**
-dontwarn org.osgi.service.**
-dontwarn org.osgi.util.**
-dontwarn org.apache.logging.log4j.**
-dontwarn com.fasterxml.woodstox.**
-dontwarn org.codehaus.stax2.**

# 针对 POI 5.x 引用缺失 AWT 类的补充屏蔽
-dontwarn org.apache.poi.xslf.**
-dontwarn org.apache.poi.sl.**
-dontwarn org.apache.poi.common.usermodel.draw.**

# ----------------------------------------------------
# Room & SQLite
# ----------------------------------------------------
-keep class * extends androidx.room.RoomDatabase
-dontwarn androidx.room.paging.**
-keep class com.ai.wangcai.data.PetDao { <methods>; }
